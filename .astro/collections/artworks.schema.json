{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "added": {
      "type": "string",
      "format": "date-time"
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "width": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "height": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "added",
    "image",
    "width",
    "height"
  ]
}