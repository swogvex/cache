---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
  view?: 'index' | 'canvas';
}

const { title = 'Cache', view = 'index' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <Header view={view} />
    <slot />
  </body>
</html>