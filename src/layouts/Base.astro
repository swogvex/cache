---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Cache' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand"><sup>g</sup> Cache</a>
    </header>
    <slot />
  </body>
</html>